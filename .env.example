# ==============================================================================
# AutoApply Cloud Production Environment Configuration
# All components below run on 100% Free Tiers ($0.00/month)
# ==============================================================================

# ===== 1. SUPABASE CLOUD DATABASE & AUTH (100% Free Tier - supabase.com) =====
# 50,000 Free Monthly Active Users, 500MB PostgreSQL, 1GB Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# Enforce authentication on all endpoints (set to true in production)
REQUIRE_AUTH=false

# ===== 2. FREE AI / LLM REASONING KEYS =====
# Google Gemini (Free 15 RPM / 1M TPM): https://aistudio.google.com
GEMINI_API_KEY=
# Groq (Free fast inference): https://console.groq.com
GROQ_API_KEY=
# Mistral AI (Free tier): https://console.mistral.ai
MISTRAL_API_KEY=

# ===== 3. HUMAN-IN-THE-LOOP (HITL) NOTIFICATIONS (100% Free) =====
# Telegram Bot (@BotFather): Real-time unanswered screening question alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Settings (Optional Gmail SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
USER_EMAIL=

# ===== 4. SERVER CONFIGURATION =====
PORT=8000
ENVIRONMENT=production
ALLOWED_ORIGINS=*
